# LLM API Keys for browser-use visual agent
# Set at least one provider key:

# Google Gemini (Recommended for fast vision agent loop)
GEMINI_API_KEY=

# OpenAI (e.g. gpt-4o, o3-mini)
OPENAI_API_KEY=

# Anthropic (e.g. claude-3-5-sonnet)
ANTHROPIC_API_KEY=

# Chrome DevTools Protocol URL (Default: http://localhost:9222)
CDP_URL=http://localhost:9222
