{
  "name": "auto-apply-ai",
  "version": "1.0.0",
  "description": "Production-ready, modular Manifest V3 browser extension that autonomously navigates, parses, generates tailored content for, and applies to jobs across LinkedIn, Wellfound, Naukri, and Indeed.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/sanitize-encoding.js",
    "sanitize": "node scripts/sanitize-encoding.js",
    "mcp": "tsx mcp-server/index.ts",
    "zip": "wxt zip",
    "compile": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.307",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.18.2",
    "@wxt-dev/module-react": "^1.1.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wxt": "^0.21.4"
  }
}
